{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off"
  },
  "rules": {},
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "build/**",
    "bin/**",
    ".astro/**",
    ".scratch/**",
    "apps/docs/dist/**",
    "apps/docs/.astro/**"
  ]
}
